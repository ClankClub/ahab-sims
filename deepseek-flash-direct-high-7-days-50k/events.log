m = (a + 11h + 22l) div 451 = (13 + 44 + 22) = 79 div 451 = 0.
month = (h + l - 7m + 114) div 31 = (4 + 1 - 0 + 114) = 119 div 31 = 3 (31*3=93). month = 3 (March).
